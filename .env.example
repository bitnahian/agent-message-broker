# Live e2e harness env (copy to `.env`, gitignored)
# CI: set these same names as CI secrets / workflow env. Only the live harnesses
# (scripts/e2e-*.mts) read these; unit tests never need them.

# ---- github feed e2e (scripts/e2e-feeds.mts) ----
# PAT used to seed + delete a throwaway private repo (repo scope is enough)
E2E_GITHUB_TOKEN=

# ---- jira feed e2e (scripts/e2e-feeds.mts) ----
# Account the API token belongs to + the cloud site + a sandbox project key
E2E_JIRA_EMAIL=
E2E_JIRA_API_TOKEN=
E2E_JIRA_DOMAIN=your-site.atlassian.net
E2E_JIRA_PROJECT=KAN

# ---- google feed e2e (scripts/e2e-google.mts) — all optional ----
# Client: defaults to .secrets/google-oauth-client.json when unset
E2E_GOOGLE_CLIENT_JSON=
# Token: defaults to ~/.amb/google/token.json (from `amb google login`) when unset
E2E_GOOGLE_TOKEN_JSON=

# ---- misc ----
# Repo-name prefix for throwaway e2e repos (default: amb-e2e-)
# E2E_GITHUB_REPO_PREFIX=amb-e2e-
